{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ari.local/discovery/stage-artifact.schema.json",
  "title": "StageArtifact",
  "type": "object",
  "required": ["contract_version", "client_id", "engagement_id", "stage", "stage_name", "status", "facts", "inferences", "assumptions", "contradictions", "missing_information", "conclusions", "sources", "change_requests"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "client_id": { "type": "string", "minLength": 1 },
    "engagement_id": { "type": "string", "minLength": 1 },
    "stage": { "type": "integer", "minimum": 1, "maximum": 6 },
    "stage_name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "needs_input", "pending_approval", "approved"] },
    "facts": { "type": "array", "items": { "type": "string" } },
    "inferences": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "contradictions": { "type": "array", "items": { "type": "string" } },
    "missing_information": { "type": "array", "items": { "type": "string" } },
    "conclusions": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "type": "string" } },
    "change_requests": { "type": "array", "items": { "type": "string" } },
    "approved_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
